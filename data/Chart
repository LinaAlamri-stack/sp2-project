import streamlit as st
import pandas as pd
import plotly.express as px

# 1. قراءة البيانات
df = pd.read_csv("data/clustering_results.csv")ة
user_caffeine = 2 
user_sleep = 7
cluster_data = df 

st.subheader("Effect of Caffeine on Sleep Hours")

# =========================
# الرسم الأول: Scatter Plot
# =========================
fig1 = px.scatter(
    df,
    x="caffeine_per_day",
    y="sleep_hours",
    trendline="ols",
    labels={
        "caffeine_per_day": "Caffeine Cups per Day",
        "sleep_hours": "Sleep Hours"
    },
    title="Relationship Between Caffeine Intake and Sleep"
)

# تحديث التنسيق قبل العرض
fig1.update_layout(
    template="plotly_dark",
    paper_bgcolor="#0b1742",
    plot_bgcolor="#0f1f5c",
    font=dict(color="white"),
)

st.plotly_chart(fig1, use_container_width=True)

# =========================
# الرسم الثاني: المتوسط (Line Chart)
# =========================
sleep_avg = df.groupby("caffeine_per_day")["sleep_hours"].mean().reset_index()

fig2 = px.line(
    sleep_avg,
    x="caffeine_per_day",
    y="sleep_hours",
    markers=True,
    title="Average Sleep vs Caffeine Intake"
)

# إضافة نقطة المستخدم "You" على خط المتوسطات
fig2.add_scatter(
    x=[user_caffeine],
    y=[user_sleep],
    mode="markers+text",
    text=["You"],
    textposition="top center",
    marker=dict(size=15, color="yellow"),
    name="Your Position"
)

st.plotly_chart(fig2, use_container_width=True)

# =========================
# الرسم الثالث: التحليل المتقدم (Caffeine vs Sleep)
# =========================
st.markdown('<div style="color:white; font-size:24px; font-weight:bold; margin-bottom:10px;">Caffeine vs Sleep Analysis</div>', unsafe_allow_html=True)

fig_sleep = px.scatter(
    cluster_data,
    x="caffeine_per_day",
    y="sleep_hours",
    trendline="ols",
    opacity=0.7,
    labels={
        "caffeine_per_day": "Caffeine Cups / Day",
        "sleep_hours": "Sleep Hours"
    }
)

# نقطة المستخدم المميزة
fig_sleep.add_scatter(
    x=[user_caffeine],
    y=[user_sleep],
    mode="markers+text",
    text=["You"],
    textposition="bottom center",
    marker=dict(
        size=16,
        color="#FFD166",
        symbol="diamond",
        line=dict(color="white", width=2)
    ),
    name="You"
)

fig_sleep.update_layout(
    template="plotly_dark",
    paper_bgcolor="#0b1742",
    plot_bgcolor="#0f1f5c",
    font=dict(color="white"),
    height=550
)

st.plotly_chart(fig_sleep, use_container_width=True)
