import streamlit as st
import pandas as pd
import plotly.express as px

# قراءة البيانات
df = pd.read_csv("data/clustering_results.csv")

st.subheader("Effect of Caffeine on Sleep Hours")

# رسم Scatter Plot
fig = px.scatter(
    df,
    x="caffeine_per_day",
